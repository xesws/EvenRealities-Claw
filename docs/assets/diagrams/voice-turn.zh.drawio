<mxfile host="EvenRealities-Claw" type="device"><diagram name="voice-turn"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="1 · 按住说话&amp;#10;眼镜 → 插件 → 网关&amp;#10;HUD：S2 聆听" style="rounded=1;fillColor=#f4f4f6;strokeColor=#6b7280;fontSize=12;fontColor=#1f2933" vertex="1" parent="1"><mxGeometry x="30" y="30" width="200" height="76" as="geometry"/></mxCell><mxCell id="t2" value="2 · 先真的开麦&amp;#10;插件等 audioControl(true) 返回，&amp;#10;再发 ptt start" style="rounded=1;fillColor=#ffffff;strokeColor=#8a94a6;fontSize=12;fontColor=#1f2933" vertex="1" parent="1"><mxGeometry x="270" y="30" width="200" height="76" as="geometry"/></mxCell><mxCell id="t3" value="3 · 每 100ms 一块 PCM 上行&amp;#10;16kHz 单声道 s16le&amp;#10;音频不落盘" style="rounded=1;fillColor=#ffffff;strokeColor=#8a94a6;fontSize=12;fontColor=#1f2933" vertex="1" parent="1"><mxGeometry x="510" y="30" width="200" height="76" as="geometry"/></mxCell><mxCell id="t4" value="4 · 流式 ASR&amp;#10;部分转写 → 尾部滚动窗&amp;#10;HUD：S2，字在动" style="rounded=1;fillColor=#eef4ff;strokeColor=#4a6fa5;fontSize=12;fontColor=#1f2933" vertex="1" parent="1"><mxGeometry x="750" y="30" width="210" height="76" as="geometry"/></mxCell><mxCell id="t5" value="5 · 松手 → 最终转写&amp;#10;自建 10 条数据集 CER 0.0085&amp;#10;HUD：S3 已听到" style="rounded=1;fillColor=#eef4ff;strokeColor=#4a6fa5;fontSize=12;fontColor=#1f2933" vertex="1" parent="1"><mxGeometry x="750" y="150" width="210" height="76" as="geometry"/></mxCell><mxCell id="t6" value="6 · route() 选 skill&amp;#10;确定性代码选，不是模型选&amp;#10;HUD：S4 思考" style="rounded=1;fillColor=#eefaf1;strokeColor=#3f8f5f;fontSize=12;fontColor=#1f2933" vertex="1" parent="1"><mxGeometry x="510" y="150" width="200" height="76" as="geometry"/></mxCell><mxCell id="t7" value="7 · policy.check → 真跑工具&amp;#10;每次调用与每次拒绝都进审计&amp;#10;HUD：S5 工具" style="ro